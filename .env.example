# Copy to .env. Never commit the real file.
#
# Credentials for a Send4 API client with the "WordPress plugin" ability.
# Mint one per site: Send4 keeps a single active token per API client, so two
# sites sharing one key would revoke each other's token on every refresh.
#
# Left commented out on purpose: an empty value still counts as "supplied".
# SEND4_CLIENT_ID=
# SEND4_CLIENT_SECRET=

# Where the plugin sends submissions. Defaults to the Laravel app on the host.
# SEND4_API_BASE_URL=http://host.docker.internal:8080

# Port the development site is published on.
# WP_HOST_PORT=8088
